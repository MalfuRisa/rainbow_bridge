# syntax=docker/dockerfile:1

##
## Build configuration
##
ARG BINARY_ARTIFACT_URL
# 无默认值:让 BuildKit 按 --platform 注入目标架构。
# 写默认值(如 =amd64)会被 stage 内的 ARG 继承,导致 arm64 变体也下载 amd64 包。
ARG TARGETOS
ARG TARGETARCH

##
## Binary artifact stage
##
FROM debian:bookworm-slim AS binary-artifact

ARG BINARY_ARTIFACT_URL
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    tar \
    unzip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /artifact

RUN test -n "$BINARY_ARTIFACT_URL" && \
    ARTIFACT_URL="$(printf '%s' "$BINARY_ARTIFACT_URL" | sed "s/__ARCH__/${TARGETARCH}/g")" && \
    wget -O artifact.tar.gz "$ARTIFACT_URL" && \
    tar -xzf artifact.tar.gz --strip-components=1 && \
    test -x /artifact/app

##
## App runtime stage (target: app)
## Full application with embedded frontend
##
FROM debian:bookworm-slim AS app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget && \
    rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --uid 10001 rainbow

WORKDIR /app

# 从binary-artifact阶段复制预构建的二进制文件和前端文件
COPY --from=binary-artifact /artifact/app /app/server
COPY --from=binary-artifact /artifact/web /app/web
COPY config.yaml /app/config.yaml

RUN mkdir -p /app/data/uploads /var/lib/rainbow_bridge && chown -R rainbow:rainbow /app /var/lib/rainbow_bridge

USER rainbow

EXPOSE 8080

ENTRYPOINT ["/app/server"]
CMD ["--config", "/app/config.yaml"]
